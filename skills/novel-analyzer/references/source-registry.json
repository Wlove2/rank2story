{
  "schema_version": "3.0",
  "version": "2026-07-20.machine-enforced-acquisition-contracts",
  "intent_routing": {
    "short_examples": [
      "短篇扫榜",
      "扫短故事榜准备投稿"
    ],
    "long_examples": [
      "长篇扫榜",
      "扫长篇榜准备开书"
    ],
    "ambiguous_rule": "only ask long_or_short when lane is unknown",
    "internal_flags_are_user_visible": false,
    "production_fixtures_forbidden": true
  },
  "length_router": {
    "official_short_rule": "official short/story surface is authoritative for short lane regardless of word count",
    "official_long_rule": "official novel/long-form surface is authoritative for long lane",
    "word_count_role": "descriptive capacity feature only; never a gate for official short items",
    "capacity_bands": [
      "under_10k",
      "10k_30k",
      "30k_80k",
      "over_80k"
    ],
    "mixed_surface_unknown_rule": "keep as unknown context until title, work URL, or complete content proves lane"
  },
  "sampling_policy": {
    "preserve_raw_first_page": true,
    "base_top_n_per_list": 6,
    "adaptive_max_top_n_per_list": 10,
    "small_complete_source_max_unique": 25,
    "small_complete_source_rule": "analyze all unique works",
    "adaptive_expansion_rule": "expand ranks 7-10 only when at least half of base six duplicate prior lists on the same source",
    "list_aggregation": "equal_weight_per_list_then_platform_cap",
    "duplicate_rule": "deduplicate by platform book id; preserve appearances; cap cross-list bonus",
    "app_web_relation": "independent surfaces; calculate overlap every batch",
    "context_sources_add_heat_score": false
  },
  "source_mix_policy": {
    "purpose": "deterministic influence caps for evidence synthesis; never acquisition quotas and never a substitute for required-source coverage",
    "missing_required_source_rule": "block formal candidates; do not renormalize the missing source budget onto sources that happened to succeed",
    "within_cohort_rule": "normalize within each platform first; equalize named rank lists; then apply the cohort cap",
    "duplicate_rule": "one work or canonical URL keeps one evidence_id; repeated appearances preserve provenance but cannot create a second source budget",
    "long": {
      "fanqie_official": {
        "cap": 0.4,
        "source_ids": [
          "fanqie_public_web_ranks",
          "fanqie_reader_novel_rank_center"
        ]
      },
      "qimao_official": {
        "cap": 0.2,
        "source_ids": [
          "qimao_public_web_ranks",
          "qimao_reader_rank_center"
        ]
      },
      "paid_platform_corroboration": {
        "cap": 0.2,
        "source_ids": [
          "zongheng_public_rank_snapshot",
          "jjwxc_quarter_rank_snapshot",
          "qidian_paid_trend_target"
        ],
        "allocation": "equal across successful named platforms after the all-required gate passes"
      },
      "xiaohongshu_demand": {
        "cap": 0.1,
        "source_ids": [
          "xiaohongshu_novel_demand_shared"
        ]
      },
      "bilibili_demand": {
        "cap": 0.1,
        "source_ids": [
          "bilibili_novel_demand_shared"
        ]
      },
      "historical_basis": "20260628 analytical priority: Fanqie 40%, Qimao 20%, Zongheng 10%, JJWXC 10%, Xiaohongshu 10%, Bilibili 10%; Qidian now shares the unchanged 20% paid-platform cohort"
    },
    "short": {
      "fanqie_official_short": {
        "cap": 0.4,
        "source_ids": [
          "fanqie_writer_hot_stories",
          "fanqie_reader_short_rank_center"
        ]
      },
      "qimao_official_story": {
        "cap": 0.3,
        "source_ids": [
          "qimao_reader_story_rank_center"
        ]
      },
      "xiaohongshu_demand": {
        "cap": 0.15,
        "source_ids": [
          "xiaohongshu_novel_demand_shared"
        ]
      },
      "bilibili_demand": {
        "cap": 0.15,
        "source_ids": [
          "bilibili_novel_demand_shared"
        ]
      },
      "rationale": "the old mixed-lane ratio cannot be copied mechanically; official short/story surfaces retain 70% while two independently verified reader-demand sources share 30%"
    }
  },
  "lane_classification_policy": {
    "official_short_surfaces": [
      "fanqie_writer_hot_stories",
      "fanqie_reader_short_rank_center",
      "qimao_reader_story_rank_center"
    ],
    "official_long_surfaces": [
      "fanqie_public_web_ranks",
      "fanqie_reader_novel_rank_center",
      "qimao_public_web_ranks",
      "qimao_reader_rank_center",
      "zongheng_public_rank_snapshot",
      "jjwxc_quarter_rank_snapshot",
      "qidian_paid_trend_target"
    ],
    "shared_context_surfaces": [
      "fanqie_writer_activities",
      "fanqie_writer_notices",
      "qimao_writer_editorial_and_rules"
    ],
    "shared_social_surfaces": [
      "xiaohongshu_novel_demand_shared",
      "bilibili_novel_demand_shared"
    ],
    "mixed_social_rule": "complete generic xiaohongshu/bilibili novel recommendation or book-shortage content is tagged both when its lane cannot be verified; it is auxiliary evidence for either requested lane and is counted once",
    "shared_social_dedup_rule": "collect one snapshot per platform per run; reuse the same evidence_id in either lane packet and never copy or sum it as separate short and long evidence",
    "social_both_scoring_eligible": true,
    "unknown_scoring_eligible": false,
    "diagnostic_sources_never_satisfy_lane_coverage": true
  },
  "social_acquisition_policy": {
    "min_discovered_unique_per_platform": 20,
    "min_screened_per_platform": 10,
    "min_signal_eligible_entries_per_platform": 5,
    "min_unique_accounts_per_platform": 3,
    "max_signal_entries_per_account": 2,
    "required_primary_signal_type_counts": {
      "current_hotspot_or_rank_scan": 1,
      "curator_roundup": 1,
      "reader_demand_or_book_shortage": 1,
      "negative_or_avoidance": 1
    },
    "primary_signal_types": [
      "current_hotspot_or_rank_scan",
      "curator_roundup",
      "reader_demand_or_book_shortage",
      "negative_or_avoidance",
      "creator_market_analysis"
    ],
    "query_families": [
      "current platform rank scan",
      "current hot novel or genre",
      "book shortage and recommendations",
      "curator list and roundup",
      "reader complaints and abandonment",
      "creator market analysis"
    ],
    "watchlist_rule": "a named account is a discovery route, not trusted evidence; verify its current item URL, date, engagement and complete content every run",
    "official_rank_repost_rule": "when a social item only republishes an already acquired official rank, retain provenance but set signal_eligible=false and heat_increment=0; original commentary may be classified separately without duplicating the rank",
    "search_summary_rule": "search results populate discovery and screening only; they never satisfy signal eligibility",
    "source_specific_overrides": {
      "xiaohongshu_novel_demand_shared": {
        "reason": "Owner-approved 2026-10-09 reduced source sample quota; complete media and original source verifiability unchanged.",
        "coverage_source_of_truth": "sources[id=xiaohongshu_novel_demand_shared].coverage"
      }
    }
  },
  "required_source_failure_policy": {
    "transient_attempts": 3,
    "fresh_transport_each_attempt": true,
    "on_exhaustion": "degraded_and_formal_gate_closed",
    "substitution_forbidden": true,
    "forbidden_summary": "其他榜已足够分析"
  },
  "runtime_contract": {
    "windows_python": "python",
    "runtime_installs_forbidden": true,
    "ad_hoc_collector_authoring_forbidden": true,
    "scan_output_root": "./data/scans",
    "file_dependencies": [],
    "rank_input_policy": "current_run_only",
    "previous_rank_inputs_allowed": false,
    "preflight_profiles": {
      "short_production": {
        "commands": [
          "opencli",
          "agent-reach"
        ],
        "timeout_seconds": 10,
        "endpoints": [
          "https://fanqienovel.com/api/user/info/v2",
          "https://api5-normal.fqnovel.com/reading/bookapi/bookmall/tab/v1/",
          "https://api-bc.wtzw.com/api/v1/story/leader-board"
