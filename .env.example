# Copy to .env in the project root and edit for your own model.
# .env is ignored by Git. NEVER commit real secrets or paste them into chats.
# OpenAI-compatible base URL including /v1, supplied by your model provider.
MODEL_BASE_URL=https://your-endpoint.example/v1
MODEL_ID=your-model-id
# Leave empty when your authorized local endpoint does not require a key.
MODEL_API_KEY=
